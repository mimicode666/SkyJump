config_version=5

[application]
config/name="SkyJump"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Прыжки по платформам от земли к далёкому космосу."

[display]
window/size/viewport_width=1100
window/size/viewport_height=780
window/size/window_width_override=1100
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.47, 0.79, 0.95, 1)

[physics]
common/physics_ticks_per_second=60
